{
  "name": "manufacturer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "build:basic": "tsc && vite build --mode basic",
    "build:full": "tsc && vite build --mode full",
    "preview": "vite preview",
    "preview:basic": "vite preview --mode basic --port 4181",
    "preview:full": "vite preview --mode full --port 4182",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "break_eternity.js": "^2.1.3",
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
